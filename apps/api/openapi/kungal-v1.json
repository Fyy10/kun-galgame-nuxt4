{
  "components": {
    "schemas": {
      "FieldError": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "description": "English diagnostic for this location. Free text; never use it as a decision input.",
            "maxLength": 4096,
            "type": "string"
          },
          "header": {
            "description": "Header name. Exactly one of pointer, parameter, or header is present.",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9-]+$",
            "type": "string"
          },
          "parameter": {
            "description": "Query or path parameter name. Exactly one of pointer, parameter, or header is present.",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._\\[\\]-]+$",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/FieldParams",
            "description": "Reason-specific bounds or allowed values. Omitted when the reason has no params."
          },
          "pointer": {
            "description": "JSON Pointer to a body location. Exactly one of pointer, parameter, or header is present.",
            "maxLength": 512,
            "pattern": "^(/([^/~]|~[01])*)*$",
            "type": "string"
          },
          "reason": {
            "description": "Field-level reason. UPPER_SNAKE. Disjoint from top-level codes.",
            "maxLength": 63,
            "minLength": 2,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "detail"
        ],
        "type": "object"
      },
      "FieldParams": {
        "additionalProperties": true,
        "properties": {
          "allowed": {
            "description": "Closed vocabulary members that were expected.",
            "items": {
              "maxLength": 128,
              "pattern": "^[\\x20-\\x7E]+$",
              "type": "string"
            },
            "maxItems": 256,
            "type": "array"
          },
          "max_items": {
            "description": "Maximum array length the value exceeded.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "max_length": {
            "description": "Maximum string length the value exceeded.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "maximum": {
            "description": "Inclusive numeric upper bound the value missed.",
            "format": "double",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "number"
          },
          "min_items": {
            "description": "Minimum array length the value failed.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "min_length": {
            "description": "Minimum string length the value failed.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "minimum": {
            "description": "Inclusive numeric lower bound the value missed.",
            "format": "double",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "number"
          }
        },
        "type": "object"
      },
      "Image": {
        "additionalProperties": true,
        "properties": {
          "hash": {
            "description": "Image-service content hash.",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "height": {
            "description": "Pixel height. null if unknown.",
            "format": "int64",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sexual": {
            "description": "Sexual depiction: safe, suggestive, or explicit. null means not assessed.",
            "enum": [
              "safe",
              "suggestive",
              "explicit",
              null
            ],
            "maxLength": 11,
            "type": [
              "string",
              "null"
            ],
            "x-vocabulary-closed": true
          },
          "thumbhash": {
            "description": "Thumbhash. null if unknown.",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9+/=_-]+$",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "Absolute image URL. Never a bare hash.",
            "format": "uri",
            "maxLength": 512,
            "type": "string"
          },
          "width": {
            "description": "Pixel width. null if unknown.",
            "format": "int64",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "url",
          "hash",
          "width",
          "height",
          "thumbhash",
          "sexual"
        ],
        "type": "object"
      },
      "ListProblemReason": {
