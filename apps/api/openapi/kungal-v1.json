  "info": {
    "description": "The first-party API of the KUN Galgame forum for its website and app. It is in preview.\n\nClients must ignore unknown fields in responses.\nClients must tolerate unseen values of open vocabularies; an unknown content node type renders its children or plain text.\nClients must handle an unknown error `code` with a fallback keyed on `status`.",
    "title": "KUN Galgame Forum API",
    "version": "1.0.0-preview",
    "x-stability": "preview"
  },
  "openapi": "3.1.0",
  "paths": {
    "/problems": {
      "get": {
        "description": "The closed registry of top-level error codes. Unauthenticated. Sorted by domain, then code.",
        "operationId": "listProblemTypes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProblemType"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List every top-level error code",
        "tags": [
          "meta"
        ]
      }
    },
    "/problems/reasons": {
      "get": {
        "description": "The closed registry of field-level reasons. Unauthenticated. Values in this list never appear as top-level codes.",
        "operationId": "listProblemReasons",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProblemReason"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List every field-level error reason",
        "tags": [
          "meta"
        ]
      }
    },
    "/topics": {
      "get": {
        "description": "Lists topics visible to the caller as a cursor page. Anonymous callers see public published topics. Signed-in callers also see login-scoped topics. Role and user grants never appear. Hidden topics never appear. Topics by banned authors are left out; the server reads on to fill the page, so every page but the last holds limit items unless a long run of such topics cuts it short. Continue while next_cursor is present, whatever the page size.",
        "operationId": "listTopics",
        "parameters": [
          {
            "description": "Opaque keyset cursor from a previous page of this collection.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque keyset cursor from a previous page of this collection.",
              "maxLength": 512,
              "pattern": "^cur_[A-Za-z0-9_-]+$",
              "type": "string"
            }
          },
          {
            "description": "Page size. 1–100, default 20. Values above 100 are rejected, not clamped.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "description": "Page size. 1–100, default 20. Values above 100 are rejected, not clamped.",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Sort order; ties break on id in the same direction. Default bumped_desc. bumped: bumped_at. created: created_at. views: view_count. views_1d: views today. views_7d and views_30d: views in the last 7 or 30 days, recomputed daily. likes: like_count. favorites: times favorited. upvotes: times upvoted.",
            "explode": false,
            "in": "query",
            "name": "sort",
            "schema": {
              "default": "bumped_desc",
              "description": "Sort order; ties break on id in the same direction. Default bumped_desc. bumped: bumped_at. created: created_at. views: view_count. views_1d: views today. views_7d and views_30d: views in the last 7 or 30 days, recomputed daily. likes: like_count. favorites: times favorited. upvotes: times upvoted.",
              "enum": [
                "bumped_asc",
                "bumped_desc",
                "created_asc",
                "created_desc",
                "views_asc",
                "views_desc",
                "views_1d_asc",
                "views_1d_desc",
                "views_7d_asc",
                "views_7d_desc",
