{
  "components": {
    "schemas": {
      "FieldError": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "description": "English diagnostic for this location. Free text; never use it as a decision input.",
            "maxLength": 4096,
            "type": "string"
          },
          "header": {
            "description": "Header name. Exactly one of pointer, parameter, or header is present.",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9-]+$",
            "type": "string"
          },
          "parameter": {
            "description": "Query or path parameter name. Exactly one of pointer, parameter, or header is present.",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._\\[\\]-]+$",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/FieldParams",
            "description": "Reason-specific bounds or allowed values. Omitted when the reason has no params."
          },
          "pointer": {
            "description": "JSON Pointer to a body location. Exactly one of pointer, parameter, or header is present.",
            "maxLength": 512,
            "pattern": "^(/([^/~]|~[01])*)*$",
            "type": "string"
          },
          "reason": {
            "description": "Field-level reason. UPPER_SNAKE. Disjoint from top-level codes.",
            "maxLength": 63,
            "minLength": 2,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "detail"
        ],
        "type": "object"
      },
      "FieldParams": {
        "additionalProperties": true,
        "properties": {
          "allowed": {
            "description": "Closed vocabulary members that were expected.",
            "items": {
              "maxLength": 128,
              "pattern": "^[\\x20-\\x7E]+$",
              "type": "string"
            },
            "maxItems": 256,
            "type": "array"
          },
          "max_items": {
            "description": "Maximum array length the value exceeded.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "max_length": {
            "description": "Maximum string length the value exceeded.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "maximum": {
            "description": "Inclusive numeric upper bound the value missed.",
            "format": "double",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "number"
          },
          "min_items": {
            "description": "Minimum array length the value failed.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "min_length": {
            "description": "Minimum string length the value failed.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "minimum": {
            "description": "Inclusive numeric lower bound the value missed.",
            "format": "double",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "number"
          }
        },
        "type": "object"
      },
      "ListProblemReason": {
        "additionalProperties": true,
        "properties": {
          "items": {
            "description": "Members of this page. Empty array, never null.",
            "items": {
              "$ref": "#/components/schemas/ProblemReason"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Opaque keyset cursor. Omitted on the last page.",
            "maxLength": 512,
            "pattern": "^cur_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "object": {
            "description": "Type discriminant. Always list.",
            "enum": [
              "list"
            ],
            "maxLength": 4,
            "type": "string",
            "x-vocabulary-closed": true
          },
          "total": {
            "description": "Present only when include_total=true. Same visibility gate as items.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "object",
          "items"
        ],
        "type": "object"
      },
      "ListProblemType": {
        "additionalProperties": true,
        "properties": {
          "items": {
            "description": "Members of this page. Empty array, never null.",
            "items": {
              "$ref": "#/components/schemas/ProblemType"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Opaque keyset cursor. Omitted on the last page.",
            "maxLength": 512,
            "pattern": "^cur_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "object": {
            "description": "Type discriminant. Always list.",
            "enum": [
              "list"
            ],
            "maxLength": 4,
            "type": "string",
            "x-vocabulary-closed": true
          },
          "total": {
            "description": "Present only when include_total=true. Same visibility gate as items.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "object",
          "items"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "description": "Top-level error code. UPPER_SNAKE.",
            "maxLength": 63,
            "minLength": 2,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
          },
          "detail": {
            "description": "English diagnostic for this request. Free text; never use it as a decision input.",
            "maxLength": 4096,
            "type": "string"
          },
          "errors": {
            "description": "Field-level errors. Empty array, never null.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "Request path and query that failed.",
            "maxLength": 4096,
            "pattern": "^/\\S*$",
            "type": "string"
          },
          "request_id": {
            "description": "Request correlation id. Echoed from X-Request-ID when valid.",
            "maxLength": 30,
            "minLength": 30,
            "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "status": {
            "description": "HTTP status this code is bound to. One status per code.",
            "format": "int64",
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "description": "Stable English phrase for this type. Does not vary per request.",
            "maxLength": 128,
            "pattern": "^[ -~]+$",
            "type": "string"
          },
          "type": {
            "description": "Problem type URI. The last path segment is the kebab-case form of code.",
            "format": "uri",
            "maxLength": 256,
            "pattern": "^https://developer\\.nextmoe\\.dev/problems/[a-z]+/[a-z0-9-]+$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id",
          "errors"
        ],
        "type": "object"
      },
      "ProblemReason": {
        "additionalProperties": true,
        "properties": {
          "description": {
            "description": "English prose. Free text; never use it as a decision input.",
            "maxLength": 512,
            "type": "string"
          },
          "object": {
            "description": "Type discriminant. Always problem_reason.",
            "enum": [
              "problem_reason"
            ],
            "maxLength": 14,
            "type": "string",
            "x-vocabulary-closed": true
          },
          "param_names": {
            "description": "Keys this reason can carry in a field error's params. Empty array when it carries none.",
            "items": {
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "reason": {
            "description": "Field-level reason. UPPER_SNAKE. Disjoint from top-level codes.",
            "maxLength": 63,
            "minLength": 2,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
          },
          "title": {
            "description": "Stable English phrase for this reason.",
            "maxLength": 128,
            "pattern": "^[ -~]+$",
            "type": "string"
          }
        },
        "required": [
          "object",
          "reason",
          "title",
          "description",
          "param_names"
        ],
        "type": "object"
      },
      "ProblemType": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "description": "Top-level error code. UPPER_SNAKE.",
            "maxLength": 63,
            "minLength": 2,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
          },
          "description": {
            "description": "English prose. Free text; never use it as a decision input.",
            "maxLength": 512,
            "type": "string"
          },
          "domain": {
            "description": "Type URI domain segment.",
            "enum": [
              "platform",
              "kungal"
            ],
            "maxLength": 16,
            "type": "string",
            "x-vocabulary-closed": true
          },
          "object": {
            "description": "Type discriminant. Always problem_type.",
            "enum": [
              "problem_type"
            ],
            "maxLength": 12,
            "type": "string",
            "x-vocabulary-closed": true
          },
          "status": {
            "description": "HTTP status this code is bound to. One status per code.",
            "format": "int64",
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "description": "Stable English phrase for this type. Does not vary per request.",
            "maxLength": 128,
            "pattern": "^[ -~]+$",
            "type": "string"
          },
          "type": {
            "description": "Problem type URI. The last path segment is the kebab-case form of code.",
            "format": "uri",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "object",
          "code",
          "domain",
          "status",
          "type",
          "title",
          "description"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "OAuth access token presented by the first-party app. A Bearer is presented on purpose; an invalid token is always 401 INVALID_CREDENTIAL.",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "description": "Opaque BFF session cookie issued to the website. The cookie is ambient; a stale value on an optional operation is treated as anonymous.",
        "in": "cookie",
        "name": "kungal_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The first-party API of the KUN Galgame forum for its website and app. It is in preview.\n\nClients must ignore unknown fields in responses.\nClients must tolerate unseen values of open vocabularies; an unknown content node type renders its children or plain text.\nClients must handle an unknown error `code` with a fallback keyed on `status`.",
    "title": "KUN Galgame Forum API",
    "version": "1.0.0-preview",
    "x-stability": "preview"
  },
  "openapi": "3.1.0",
  "paths": {
    "/problems": {
      "get": {
        "description": "The closed registry of top-level error codes. Unauthenticated. Sorted by domain, then code.",
        "operationId": "listProblemTypes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProblemType"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List every top-level error code",
        "tags": [
          "meta"
        ]
      }
    },
    "/problems/reasons": {
      "get": {
        "description": "The closed registry of field-level reasons. Unauthenticated. Values in this list never appear as top-level codes.",
        "operationId": "listProblemReasons",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProblemReason"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List every field-level error reason",
        "tags": [
          "meta"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://www.kungal.com/api/v1"
    }
  ]
}
