      "Problem": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "description": "Top-level error code. UPPER_SNAKE.",
            "maxLength": 63,
            "minLength": 2,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
