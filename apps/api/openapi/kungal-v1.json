{
  "components": {
    "schemas": {
      "FieldError": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "type": "string"
          },
          "header": {
            "type": "string"
          },
          "parameter": {
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/FieldParams"
          },
          "pointer": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason",
          "detail"
        ],
        "type": "object"
      },
      "FieldParams": {
        "additionalProperties": true,
        "properties": {
          "allowed": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "max_items": {
            "format": "int64",
            "type": "integer"
          },
          "max_length": {
            "format": "int64",
            "type": "integer"
          },
          "maximum": {
            "format": "double",
            "type": "number"
          },
          "min_items": {
            "format": "int64",
            "type": "integer"
          },
          "min_length": {
            "format": "int64",
            "type": "integer"
          },
          "minimum": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "ListObjectProblemReason": {
        "additionalProperties": true,
        "properties": {
          "items": {
            "description": "The members of this list. Empty array, never null.",
            "items": {
              "$ref": "#/components/schemas/ProblemReason"
            },
            "maxItems": 256,
            "type": "array"
          },
          "object": {
            "description": "Type discriminant. Always list.",
            "enum": [
              "list"
            ],
            "maxLength": 4,
            "type": "string"
          }
        },
        "required": [
          "object",
          "items"
        ],
        "type": "object"
      },
      "ListObjectProblemType": {
        "additionalProperties": true,
        "properties": {
          "items": {
            "description": "The members of this list. Empty array, never null.",
            "items": {
              "$ref": "#/components/schemas/ProblemType"
            },
            "maxItems": 256,
            "type": "array"
          },
          "object": {
            "description": "Type discriminant. Always list.",
            "enum": [
              "list"
            ],
            "maxLength": 4,
            "type": "string"
          }
        },
        "required": [
          "object",
          "items"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id",
          "errors"
        ],
        "type": "object"
      },
      "ProblemReason": {
        "additionalProperties": true,
        "properties": {
          "description": {
            "description": "English prose. Must not be used as a discriminant.",
            "maxLength": 512,
            "type": "string"
          },
          "object": {
            "description": "Type discriminant. Always problem_reason.",
            "enum": [
              "problem_reason"
            ],
            "maxLength": 14,
            "type": "string"
          },
          "params": {
            "description": "Declared param key names for this reason. Empty array when the reason carries no params.",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "reason": {
            "description": "Field-level reason. UPPER_SNAKE. Disjoint from top-level codes.",
            "maxLength": 63,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
          },
          "title": {
            "description": "Stable English phrase for this reason.",
            "maxLength": 128,
            "pattern": "^[ -~]+$",
            "type": "string"
          }
        },
        "required": [
          "object",
          "reason",
          "title",
          "description",
          "params"
        ],
        "type": "object"
      },
      "ProblemType": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "description": "Top-level error code. UPPER_SNAKE.",
            "maxLength": 63,
            "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$",
            "type": "string"
          },
          "description": {
            "description": "English prose. Must not be used as a discriminant.",
            "maxLength": 512,
            "type": "string"
          },
          "domain": {
            "description": "Type URI domain segment.",
            "enum": [
              "platform",
              "kungal"
            ],
            "maxLength": 16,
            "type": "string"
          },
          "object": {
            "description": "Type discriminant. Always problem_type.",
            "enum": [
              "problem_type"
            ],
            "maxLength": 12,
            "type": "string"
          },
          "status": {
            "description": "HTTP status this code is bound to. One status per code.",
            "format": "int64",
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "description": "Stable English phrase for this type. Does not vary per request.",
            "maxLength": 128,
            "pattern": "^[ -~]+$",
            "type": "string"
          },
          "type": {
            "description": "Problem type URI. The last path segment is the kebab-case form of code.",
            "format": "uri",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "object",
          "code",
          "domain",
          "status",
          "type",
          "title",
          "description"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "OAuth access token presented by the first-party app. A Bearer is presented on purpose; an invalid token is always 401 INVALID_CREDENTIAL.",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "description": "Opaque BFF session cookie issued to the website. The cookie is ambient; a stale value on an optional operation is treated as anonymous.",
        "in": "cookie",
        "name": "kungal_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The first-party API of the KUN Galgame forum for its website and app. It is in preview.\n\nClients must ignore unknown fields in responses.\nClients must tolerate unseen values of open vocabularies; an unknown content node type renders its children or plain text.\nClients must handle an unknown error `code` with a fallback keyed on `status`.",
    "title": "KUN Galgame Forum API",
    "version": "1.0.0-preview",
    "x-stability": "preview"
  },
  "openapi": "3.1.0",
  "paths": {
    "/problems": {
      "get": {
        "description": "The closed registry of top-level error codes. Unauthenticated. Sorted by domain, then code.",
        "operationId": "listProblemTypes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListObjectProblemType"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List every top-level error code",
        "tags": [
          "meta"
        ]
      }
    },
    "/problems/reasons": {
      "get": {
        "description": "The closed registry of field-level reasons. Unauthenticated. Values in this list never appear as top-level codes.",
        "operationId": "listProblemReasons",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListObjectProblemReason"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List every field-level error reason",
        "tags": [
          "meta"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://www.kungal.com/api/v1"
    }
  ]
}
